<?xml version="1.0"?>
<launch>

    <!-- Arguments -->
    <arg name="world_name"          default="$(find lex_simulation)/worlds/warehouse.world" />
    <arg name="model"               default="$(find lex_simulation)/robot_description/lex_robot_description.urdf.xacro" />
    <arg name="use_sim_time"        default="true" />

    <!-- Set use_sim_time parameter -->
    <param name="/use_sim_time" value="$(arg use_sim_time)" />

    <!-- TF -->
    <!-- <node name="map_to_odom" pkg="tf" type="static_transform_publisher" args="0 0 0 0 0 0 map odom 100" /> -->

    <!-- Simulation -->
    <include file="$(find lex_simulation)/launch/gazebo.launch">
        <arg name="world_name" value="$(arg world_name)" />
        <arg name="model" value="$(arg model)" />
    </include>

    <!-- Navigation -->
    <include file="$(find lex_navigation)/launch/navigation.launch"/>

</launch>