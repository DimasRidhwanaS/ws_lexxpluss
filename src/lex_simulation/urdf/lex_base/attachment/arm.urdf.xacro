<?xml version="1.0"?>
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Arm parameters -->
    <xacro:property name="arm_base_height" value="0.05" />
    <xacro:property name="arm_base_radius" value="0.04" />
    <xacro:property name="link1_length" value="0.1" />
    <xacro:property name="link1_radius" value="0.025" />
    <xacro:property name="link2_length" value="0.08" />
    <xacro:property name="link2_radius" value="0.02" />
    <xacro:property name="link3_length" value="0.06" />
    <xacro:property name="link3_radius" value="0.015" />
    <xacro:property name="gripper_length" value="0.04" />
    <xacro:property name="gripper_width" value="0.02" />

    <!-- Materials -->
    <material name="arm_color">
        <color rgba="0.5 0.5 0.5 1.0" />
    </material>
    <material name="joint_color">
        <color rgba="0.2 0.2 0.2 1.0" />
    </material>

<!-- Arm base (mounting point) -->
    <link name="arm_base">
        <visual>
            <geometry>
                <cylinder radius="${arm_base_radius}" length="${arm_base_height}" />
            </geometry>
            <origin xyz="0 0 ${arm_base_height/2}" rpy="0 0 0" />
            <material name="arm_color" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${arm_base_radius}" length="${arm_base_height}" />
            </geometry>
            <origin xyz="0 0 ${arm_base_height/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="0.5" />
            <origin xyz="0 0 ${arm_base_height/2}" rpy="0 0 0" />
            <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                     iyy="0.001" iyz="0.0"
                     izz="0.001" />
        </inertial>
    </link>

<!-- Joint 1: Base rotation (yaw) -->
    <joint name="arm_joint1" type="revolute">
        <parent link="arm_base" />
        <child link="arm_link1" />
        <origin xyz="0 0 ${arm_base_height}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="${-pi}" upper="${pi}" effort="10" velocity="1.0" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>

    <link name="arm_link1">
        <visual>
            <geometry>
                <cylinder radius="${link1_radius}" length="${link1_length}" />
            </geometry>
            <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0" />
            <material name="arm_color" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${link1_radius}" length="${link1_length}" />
            </geometry>
            <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="0.3" />
            <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0" />
            <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                     iyy="0.001" iyz="0.0"
                     izz="0.0001" />
        </inertial>
    </link>

<!-- Joint 2: Shoulder pitch -->
    <joint name="arm_joint2" type="revolute">
        <parent link="arm_link1" />
        <child link="arm_link2" />
        <origin xyz="0 0 ${link1_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="1.0" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>

    <link name="arm_link2">
        <visual>
            <geometry>
                <cylinder radius="${link2_radius}" length="${link2_length}" />
            </geometry>
            <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0" />
            <material name="arm_color" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${link2_radius}" length="${link2_length}" />
            </geometry>
            <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="0.2" />
            <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0" />
            <inertia ixx="0.0005" ixy="0.0" ixz="0.0"
                     iyy="0.0005" iyz="0.0"
                     izz="0.0001" />
        </inertial>
    </link>

<!-- Joint 3: Elbow pitch -->
    <joint name="arm_joint3" type="revolute">
        <parent link="arm_link2" />
        <child link="arm_link3" />
        <origin xyz="0 0 ${link2_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="${-pi/2}" upper="${pi/2}" effort="5" velocity="1.0" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>

    <link name="arm_link3">
        <visual>
            <geometry>
                <cylinder radius="${link3_radius}" length="${link3_length}" />
            </geometry>
            <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0" />
            <material name="arm_color" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${link3_radius}" length="${link3_length}" />
            </geometry>
            <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="0.1" />
            <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0" />
            <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
                     iyy="0.0002" iyz="0.0"
                     izz="0.00005" />
        </inertial>
    </link>

<!-- Joint 4: Wrist rotation -->
    <joint name="arm_joint4" type="revolute">
        <parent link="arm_link3" />
        <child link="arm_end_effector" />
        <origin xyz="0 0 ${link3_length}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="${-pi}" upper="${pi}" effort="2" velocity="1.5" />
        <dynamics damping="0.1" friction="0.1" />
    </joint>

    <link name="arm_end_effector">
        <visual>
            <geometry>
                <box size="${gripper_length} ${gripper_width} ${gripper_width}" />
            </geometry>
            <origin xyz="0 0 ${gripper_length/2}" rpy="0 0 0" />
            <material name="joint_color" />
        </visual>
        <collision>
            <geometry>
                <box size="${gripper_length} ${gripper_width} ${gripper_width}" />
            </geometry>
            <origin xyz="0 0 ${gripper_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <mass value="0.05" />
            <origin xyz="0 0 ${gripper_length/2}" rpy="0 0 0" />
            <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
                     iyy="0.00001" iyz="0.0"
                     izz="0.00001" />
        </inertial>
    </link>

    <!-- Gazebo properties -->
    <gazebo reference="arm_base">
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="arm_link1">
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="arm_link2">
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="arm_link3">
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="arm_end_effector">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Macro to attach arm to parent link -->
    <xacro:macro name="attach_arm" params="parent xyz rpy">
        <joint name="arm_mount_joint" type="fixed">
            <parent link="${parent}" />
            <child link="arm_base" />
            <origin xyz="${xyz}" rpy="${rpy}" />
        </joint>
    </xacro:macro>

</robot>