<?xml version="1.0"?>
<robot name="wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Wheel macro with explicit parameters -->
    <xacro:macro name="wheel" params="prefix reflect parent xyz rpy wheel_radius wheel_width">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="${parent}" />
            <child link="${prefix}_wheel" />
            <origin xyz="${xyz}" rpy="${rpy}" />
            <axis xyz="0 1 0" />
            <dynamics damping="0.1" friction="0.1" />
        </joint>

        <link name="${prefix}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <material name="wheel_color">
                    <color rgba="0.1 0.1 0.1 1.0" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
            </collision>
            <inertial>
                <mass value="0.1" />
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                    iyy="0.0001" iyz="0.0"
                    izz="0.0002" />
            </inertial>
        </link>

        <!-- Marker -->
        <joint name="${prefix}_marker_joint" type="fixed">
            <parent link="${prefix}_wheel" />
            <child link="${prefix}_marker_link" />
            <origin xyz="0 ${reflect*wheel_width/2} ${wheel_radius/2}" rpy="1.57 0 0" />
        </joint>


        <link name="${prefix}_marker_link">
            <visual>
                <geometry>
                    <cylinder radius="0.01" length="0.01" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0" />
                </material>
            </visual>
        </link>


        <!-- Transmission for ros_control -->
        <transmission name="${prefix}_wheel_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}_wheel_joint">
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}_wheel_motor">
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
        
        <gazebo reference="${prefix}_wheel">
            <mu1>50.0</mu1>
            <mu2>50.0</mu2>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>1.0</maxVel>
            <material>Gazebo/DarkGrey</material>
        </gazebo>
    </xacro:macro>

</robot>