<?xml version="1.0"?>
<robot name="caster_wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="caster_wheel" params="prefix parent xyz rpy caster_radius">
        <joint name="${prefix}_caster_joint" type="fixed">
            <parent link="${parent}" />
            <child link="${prefix}_caster" />
            <origin xyz="${xyz}" rpy="${rpy}" />
        </joint>

        <link name="${prefix}_caster">
            <visual>
                <geometry>
                    <sphere radius="${caster_radius}" />
                </geometry>
                <material name="wheel_color">
                    <color rgba="0.1 0.1 0.1 1.0" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${caster_radius}" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.01" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
                         iyy="0.000001" iyz="0.0"
                         izz="0.000001" />
            </inertial>
        </link>

        <gazebo reference="${prefix}_caster">
            <mu1>0.0</mu1>
            <mu2>0.0</mu2>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
            <minDepth>0.001</minDepth>
            <maxVel>1.0</maxVel>
            <material>Gazebo/Grey</material>
        </gazebo>
    </xacro:macro>

</robot>