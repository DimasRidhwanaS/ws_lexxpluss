<?xml version="1.0"?>
<robot name="livox_mid360_sensor" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Livox Mid-360 LiDAR sensor macro -->
    <!-- Specs: 360° horizontal, 59° vertical (-7° to +52°), 200k pts/sec, range 0.1-200m -->

    <xacro:macro name="livox_mid360" params="parent xyz rpy topic_name:=/livox/lidar frame_name:=livox_frame">

        <!-- Joint connecting Livox to base -->
        <joint name="livox_mid360_joint" type="fixed">
            <parent link="${parent}" />
            <child link="${frame_name}" />
            <origin xyz="${xyz}" rpy="${rpy}" />
        </joint>

        <!-- Livox Mid-360 Link -->
        <link name="${frame_name}">
            <visual>
                <geometry>
                    <cylinder radius="0.0465" length="0.041" />
                </geometry>
                <material name="livox_color">
                    <color rgba="0.15 0.15 0.15 1.0" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.0465" length="0.041" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.37" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
                         iyy="0.0002" iyz="0.0"
                         izz="0.00015" />
            </inertial>
        </link>

        <!-- Gazebo Livox Mid-360 Plugin -->
        <gazebo reference="${frame_name}">
            <sensor type="ray" name="livox_mid360">
                <pose>0 0 0 0 0 0</pose>
                <visualize>false</visualize>
                <update_rate>10</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>100</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>10</samples>
                            <resolution>1</resolution>
                            <!-- Livox Mid-360: -7° to +52° vertical FOV -->
                            <min_angle>-0.122</min_angle>
                            <max_angle>0.907</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.1</min>
                        <max>200.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </ray>
                <!-- Using standard gazebo_ros_laser plugin for PointCloud2 -->
                <plugin name="livox_mid360_plugin" filename="libgazebo_ros_block_laser.so">
                    <topicName>${topic_name}</topicName>
                    <frameName>${frame_name}</frameName>
                </plugin>
            </sensor>
            <material>Gazebo/DarkGrey</material>
        </gazebo>

    </xacro:macro>

    <!-- Livox Mid-360 with custom scan pattern (livox_ros_driver2 style) -->
    <xacro:macro name="livox_mid360_custom" params="parent xyz rpy topic_name:=/livox/lidar frame_name:=livox_frame">

        <joint name="livox_mid360_joint" type="fixed">
            <parent link="${parent}" />
            <child link="${frame_name}" />
            <origin xyz="${xyz}" rpy="${rpy}" />
        </joint>

        <link name="${frame_name}">
            <visual>
                <geometry>
                    <cylinder radius="0.0465" length="0.041" />
                </geometry>
                <material name="livox_color">
                    <color rgba="0.15 0.15 0.15 1.0" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.0465" length="0.041" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.37" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="0.0002" ixy="0.0" ixz="0.0"
                         iyy="0.0002" iyz="0.0"
                         izz="0.00015" />
            </inertial>
        </link>

        <!-- Higher resolution version for better coverage -->
        <gazebo reference="${frame_name}">
            <sensor type="ray" name="livox_mid360">
                <pose>0 0 0 0 0 0</pose>
                <visualize>false</visualize>
                <update_rate>20</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>20</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.122</min_angle>
                            <max_angle>0.907</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.1</min>
                        <max>200.0</max>
                        <resolution>0.005</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.005</stddev>
                    </noise>
                </ray>
                <plugin name="livox_mid360_plugin" filename="libgazebo_ros_block_laser.so">
                    <topicName>${topic_name}</topicName>
                    <frameName>${frame_name}</frameName>
                </plugin>
            </sensor>
            <material>Gazebo/DarkGrey</material>
        </gazebo>

    </xacro:macro>

</robot>