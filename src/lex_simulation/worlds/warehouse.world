<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse_world">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
    </physics>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Warehouse Floor -->
    <model name="warehouse_floor">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box><size>20 20 0.02</size></box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box><size>20 20 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 1.5 0 0 0</pose>
      <link name="wall_north_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>20 0.2 3</size></box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>20 0.2 3</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 1.5 0 0 0</pose>
      <link name="wall_south_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>20 0.2 3</size></box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>20 0.2 3</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1.5 0 0 0</pose>
      <link name="wall_east_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>0.2 20 3</size></box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>0.2 20 3</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1.5 0 0 0</pose>
      <link name="wall_west_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>0.2 20 3</size></box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>0.2 20 3</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Interior Wall 1 (vertical) -->
    <model name="interior_wall_1">
      <static>true</static>
      <pose>5 0 1.5 0 0 0</pose>
      <link name="interior_wall_1_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>0.15 8 3</size></box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>0.15 8 3</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Interior Wall 2 (horizontal) -->
    <model name="interior_wall_2">
      <static>true</static>
      <pose>-3 5 1.5 0 0 0</pose>
      <link name="interior_wall_2_link">
        <collision name="wall_collision">
          <geometry>
            <box><size>6 0.15 3</size></box>
          </geometry>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box><size>6 0.15 3</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf 1 -->
    <model name="shelf_1">
      <static>true</static>
      <pose>-6 -5 0.5 0 0 0</pose>
      <link name="shelf_1_link">
        <collision name="shelf_collision">
          <geometry>
            <box><size>2 0.4 1</size></box>
          </geometry>
        </collision>
        <visual name="shelf_visual">
          <geometry>
            <box><size>2 0.4 1</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf 2 -->
    <model name="shelf_2">
      <static>true</static>
      <pose>-6 5 0.5 0 0 0</pose>
      <link name="shelf_2_link">
        <collision name="shelf_collision">
          <geometry>
            <box><size>2 0.4 1</size></box>
          </geometry>
        </collision>
        <visual name="shelf_visual">
          <geometry>
            <box><size>2 0.4 1</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box 1 -->
    <model name="box_1">
      <static>true</static>
      <pose>2 -3 0.3 0 0 0.5</pose>
      <link name="box_1_link">
        <collision name="box_collision">
          <geometry>
            <box><size>0.6 0.6 0.6</size></box>
          </geometry>
        </collision>
        <visual name="box_visual">
          <geometry>
            <box><size>0.6 0.6 0.6</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.6 0.2 1</ambient>
            <diffuse>0.8 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box 2 -->
    <model name="box_2">
      <static>true</static>
      <pose>3 -3.5 0.25 0 0 0</pose>
      <link name="box_2_link">
        <collision name="box_collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="box_visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.3 0.1 1</ambient>
            <diffuse>0.6 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pillar 1 -->
    <model name="pillar_1">
      <static>true</static>
      <pose>0 0 1.5 0 0 0</pose>
      <link name="pillar_1_link">
        <collision name="pillar_collision">
          <geometry>
            <cylinder><radius>0.3</radius><length>3</length></cylinder>
          </geometry>
        </collision>
        <visual name="pillar_visual">
          <geometry>
            <cylinder><radius>0.3</radius><length>3</length></cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>