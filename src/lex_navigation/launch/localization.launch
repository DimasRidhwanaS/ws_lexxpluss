<?xml version="1.0"?>
<launch>
    <arg name="use_sim_time" default="true" />
    
    <param name="/use_sim_time" value="$(arg use_sim_time)" />
    <rosparam file="$(find lex_navigation)/config/6_ekf_localization.yaml" command="load" />

    <!-- EKF localization node -->
    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_se_odom" output="screen">
        <remap from="/odometry/filtered" to="/odom/filtered" />
    </node>

</launch>